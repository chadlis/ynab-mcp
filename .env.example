# Copy to .env and fill in your own values. Never commit the real .env.

# Required: YNAB Personal Access Token
# Create one at: YNAB > Account Settings > Developer Settings > New Token
YNAB_TOKEN=

# Optional: default budget id used by the tools when none is passed.
# Leave empty to use YNAB's "last-used" budget shortcut.
YNAB_BUDGET_ID=

# Optional transport settings (defaults shown).
# MCP_TRANSPORT=stdio       # "stdio" (local) or "http" (remote streamable-http)
# HOST=0.0.0.0              # only used for http transport
# PORT=8000                 # only used for http transport
